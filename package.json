{
  "name": "evaltape",
  "version": "0.3.1",
  "description": "Turn a demonstrated task into a human-approved outcome contract and test whether another agent satisfies it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AidaMichel/evaltape.git"
  },
  "homepage": "https://github.com/AidaMichel/evaltape#readme",
  "bugs": {
    "url": "https://github.com/AidaMichel/evaltape/issues"
  },
  "files": [
    "dist",
    "bin/evaltape.js",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "ai-agents",
    "evals",
    "agent-evaluation",
    "testing",
    "automation"
  ],
  "author": "AidaMichel",
  "license": "MIT",
  "bin": {
    "evaltape": "bin/evaltape.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
